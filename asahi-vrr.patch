+
+	/*
+	 * Internal panel: no EDID is available and dcpavserv is not used.
+	 * Provide a synthetic one advertising the VRR range so userspace can
+	 * discover the minimum refresh rate.
+	 */
+	if (dcp->nr_modes && dcp_has_panel(dcp) && !apple_connector->drm_edid) {
