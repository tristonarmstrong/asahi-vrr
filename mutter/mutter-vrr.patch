+/*
+ * Set the lowest refresh rate the output can present at. In VRR mode the
+ * frame clock throttles idle updates to this interval instead of the
+ * hardcoded MINIMUM_REFRESH_RATE. Pass 0 to fall back to the default.
+ */
+void
+clutter_frame_clock_set_min_refresh_rate (ClutterFrameClock *frame_clock,
+                                          float              refresh_rate)
+{
+  if (refresh_rate <= 0.0f)
+    refresh_rate = MINIMUM_REFRESH_RATE;
+
+  frame_clock->min_refresh_rate = refresh_rate;
+  frame_clock->maximum_refresh_interval_us =
+    (int64_t) (0.5 + G_USEC_PER_SEC / refresh_rate);
+
+  if (frame_clock->mode == CLUTTER_FRAME_CLOCK_MODE_VARIABLE &&
+      frame_clock->pending_reschedule)
+    clutter_frame_clock_schedule_flush_update (frame_clock);
+}
