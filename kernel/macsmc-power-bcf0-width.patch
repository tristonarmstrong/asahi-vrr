diff --git a/drivers/power/supply/macsmc-power.c b/drivers/power/supply/macsmc-power.c
index dc3ec5ef2..f9f56d244 100644
--- a/drivers/power/supply/macsmc-power.c
+++ b/drivers/power/supply/macsmc-power.c
@@ -46,6 +46,12 @@ struct macsmc_power {
 	bool has_ch0c;
 	bool has_chte;
 
+	/*
+	 * The battery critical key (BCF0) is 1 byte on newer SMC firmware
+	 * (macOS 15.4+, iBoot "27") and 4 bytes on older firmware.
+	 */
+	bool fw_ge_27;
+
 	u8 num_cells;
 	int nominal_voltage_mv;
 
@@ -416,6 +422,20 @@ static int macsmc_battery_get_date(const char *s, int *out)
 	return 0;
 }
 
+static int macsmc_battery_read_bcf0(struct macsmc_power *power, u32 *val)
+{
+	u8 tval = 0;
+	int ret;
+
+	if (power->fw_ge_27) {
+		ret = apple_smc_read_u8(power->smc, SMC_KEY(BCF0), &tval);
+		*val = tval;
+		return ret;
+	}
+
+	return apple_smc_read_u32(power->smc, SMC_KEY(BCF0), val);
+}
+
 static int macsmc_battery_get_capacity_level(struct macsmc_power *power)
 {
 	bool flag;
@@ -423,7 +443,7 @@ static int macsmc_battery_get_capacity_level(struct macsmc_power *power)
 	int ret;
 
 	/* Check for emergency shutdown condition */
-	if (apple_smc_read_u32(power->smc, SMC_KEY(BCF0), &val) >= 0 && val)
+	if (macsmc_battery_read_bcf0(power, &val) >= 0 && val)
 		return POWER_SUPPLY_CAPACITY_LEVEL_CRITICAL;
 
 	/* Check AC status for whether we could boot in this state */
@@ -445,6 +465,16 @@ static int macsmc_battery_get_capacity_level(struct macsmc_power *power)
 		return POWER_SUPPLY_CAPACITY_LEVEL_NORMAL;
 }
 
+static s16 macsmc_swap_b0rm(struct macsmc_power *power, s16 b0rm)
+{
+	/*
+	 * B0RM was big-endian on older firmware (a pass-through from the TI
+	 * gas gauge), but newer firmware stores it little-endian like
+	 * everything else. Only swap on the old layout.
+	 */
+	return power->fw_ge_27 ? b0rm : (s16)swab16(b0rm);
+}
+
 static int macsmc_battery_get_property(struct power_supply *psy,
 				       enum power_supply_property psp,
 				       union power_supply_propval *val)
@@ -547,7 +577,7 @@ static int macsmc_battery_get_property(struct power_supply *psy,
 		break;
 	case POWER_SUPPLY_PROP_CHARGE_NOW:
 		ret = apple_smc_read_u16(power->smc, SMC_KEY(B0RM), &vu16);
-		val->intval = swab16(vu16) * 1000;
+		val->intval = macsmc_swap_b0rm(power, vu16) * 1000;
 		break;
 	case POWER_SUPPLY_PROP_ENERGY_FULL_DESIGN:
 		ret = apple_smc_read_u16(power->smc, SMC_KEY(B0DC), &vu16);
@@ -559,7 +589,7 @@ static int macsmc_battery_get_property(struct power_supply *psy,
 		break;
 	case POWER_SUPPLY_PROP_ENERGY_NOW:
 		ret = apple_smc_read_u16(power->smc, SMC_KEY(B0RM), &vu16);
-		val->intval = swab16(vu16) * power->nominal_voltage_mv;
+		val->intval = macsmc_swap_b0rm(power, vu16) * power->nominal_voltage_mv;
 		break;
 	case POWER_SUPPLY_PROP_TEMP:
 		ret = apple_smc_read_u16(power->smc, SMC_KEY(B0AT), &vu16);
@@ -824,10 +854,11 @@ static void macsmc_power_critical_work(struct work_struct *wrk)
 		return;
 
 	/* Check for battery empty condition */
-	ret = apple_smc_read_u32(power->smc, SMC_KEY(BCF0), &bcf0);
+	ret = macsmc_battery_read_bcf0(power, &bcf0);
 	if (ret < 0) {
-		dev_err(power->dev,
-				"Emergency notification: Failed to read battery status\n");
+		dev_warn(power->dev,
+				"Emergency notification: Failed to read battery status, ignoring\n");
+		return;
 	} else if (bcf0 == 0) {
 		dev_warn(power->dev, "Emergency notification: Battery status is OK?\n");
 		return;
@@ -915,6 +946,7 @@ static int macsmc_power_probe(struct platform_device *pdev)
 {
 	struct apple_smc *smc = dev_get_drvdata(pdev->dev.parent);
 	struct power_supply_config psy_cfg = {};
+	struct apple_smc_key_info info;
 	struct macsmc_power *power;
 	bool flag;
 	u8 val8;
@@ -988,8 +1020,24 @@ static int macsmc_power_probe(struct platform_device *pdev)
 	apple_smc_read_u8(power->smc, SMC_KEY(BNCB), &power->num_cells);
 	power->nominal_voltage_mv = MACSMC_NOMINAL_CELL_VOLTAGE_MV * power->num_cells;
 
+	/*
+	 * Newer SMC firmware (macOS 15.4+) reports the critical battery flag
+	 * (BCF0) as a single byte instead of 32 bits. Determine the size so we
+	 * read it correctly; reading it with the wrong size fails and the
+	 * emergency handler would misinterpret that as an empty battery.
+	 */
+	if (apple_smc_get_key_info(power->smc, SMC_KEY(BCF0), &info) < 0) {
+		dev_warn(&pdev->dev, "Failed to determine BCF0 key size\n");
+	} else if (info.size == 1) {
+		power->fw_ge_27 = true;
+	} else if (info.size == 4) {
+		power->fw_ge_27 = false;
+	} else {
+		dev_warn(&pdev->dev, "Unexpected BCF0 key size %d\n", info.size);
+	}
+
 	/* Doing one read of this flag enables critical shutdown notifications */
-	apple_smc_read_u32(power->smc, SMC_KEY(BCF0), &val32);
+	macsmc_battery_read_bcf0(power, &val32);
 
 	psy_cfg.drv_data = power;
 	power->batt = devm_power_supply_register(&pdev->dev, &power->batt_desc, &psy_cfg);
