 }
 
@@ -397,17 +365,12 @@ int dcp_crtc_atomic_check(struct drm_crtc *crtc, struct drm_atomic_state *state)
 		return -EINVAL;
 	}
 
-	if (dcp->vrr_enabled != crtc_state->vrr_enabled) {
-		/*
-		 * Do NOT force mode_changed here: userspace (mutter) toggles
-		 * VRR_ENABLED via a page-flip atomic commit, and forcing a
-		 * modeset makes that commit fail with EINVAL. The adaptive
-		 * sync parameter is applied live from the flush path instead.
-		 */
-		dev_info(dcp->dev,
-			 "atomic_check: VRR requested %d -> %d (applied in flush)\n",
-			 dcp->vrr_enabled, crtc_state->vrr_enabled);
-	}
+	/*
+	 * Do NOT force mode_changed when vrr_enabled changes. Userspace
+	 * toggles VRR_ENABLED through a page-flip atomic commit, and forcing
+	 * a modeset here makes that commit fail with EINVAL. The adaptive
+	 * sync parameter is applied live from the flush path instead.
+	 */
 
 	return 0;
 }
