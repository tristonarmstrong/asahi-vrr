-			t2 = ns_to_mach(now_ns - pt);
-			break;
-		}
-		case 5: /* fake future deadline at pretend rate */
-		{
-			u64 pt = div_u64(1000000000ULL,
-					   apple_ts_pretend_rate ? apple_ts_pretend_rate : 1);
-			t2 = ns_to_mach(now_ns + pt);
-			break;
-		}
-		default: /* ts2 = previous present (submit-paced) */
-			t2 = prev_ns ? ns_to_mach(prev_ns) : t1;
-			break;
-		}
-		t3 = t1;
-
-		if (apple_ts_log)
-			dev_info(dcp->dev, "swap ts: mode %d period %llu us t1 %llu t2 %llu t3 %llu\n",
