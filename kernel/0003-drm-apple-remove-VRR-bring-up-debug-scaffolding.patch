 /*
- * DCP timestamps are expressed in system timer ticks. By default we
- * approximate this by converting from ktime nanoseconds to 24 MHz ticks,
- * but the tick frequency can be overridden for experimentation.
+ * DCP timestamps are expressed in system timer ticks. Approximate
+ * this by converting from ktime nanoseconds to 24 MHz ticks.
  */
-static u64 ns_to_tick(u64 ns, u64 freq)
-{
-	u64 s = ns / 1000000000ULL;
-	u64 rem = ns % 1000000000ULL;
-
-	if (!freq)
-		freq = 24000000ULL;
-	return s * freq + div_u64(rem * freq, 1000000000ULL);
-}
-
 static u64 ns_to_mach(u64 ns)
 {
-	return ns_to_tick(ns, apple_ts_freq);
+	return ns * 3 / 125;
 }
 
