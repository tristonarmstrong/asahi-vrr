@@ -1322,6 +1461,8 @@ void DCP_FW_NAME(iomfb_flush)(struct apple_dcp *dcp, struct drm_crtc *crtc, stru
 
 	crtc_state = drm_atomic_get_new_crtc_state(state, crtc);
 
