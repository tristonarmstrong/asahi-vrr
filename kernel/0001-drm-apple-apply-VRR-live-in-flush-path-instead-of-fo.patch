-		req->swap.unk_pres_ts3 = req->swap.unk_pres_ts1;
+		u64 now_ns = ktime_to_ns(ktime_get());
+		u64 prev_ns;
+		u64 t1, t2, t3;
+		u64 period_ns;
+
+		if (ktime_compare(dcp->ts_prev_flush, KTIME_MIN) == 0)
+			prev_ns = now_ns;
+		else
+			prev_ns = ktime_to_ns(dcp->ts_prev_flush);
+
+		period_ns = now_ns - prev_ns;
+		if (period_ns > 1000000000ULL)
+			period_ns = 0;
+
+		t1 = ns_to_mach(now_ns);
+		switch (apple_ts_mode) {
+		case 1: /* all identical */
+			t2 = t1;
+			break;
+		case 2: /* ts2 = scheduled next present */
+			t2 = ns_to_mach(now_ns + period_ns);
+			break;
+		case 3: /* ts2 disabled */
+			t2 = 0;
+			break;
+		case 4: /* fake past present at pretend rate */
+		{
+			u64 pt = div_u64(1000000000ULL,
+					   apple_ts_pretend_rate ? apple_ts_pretend_rate : 1);
+			t2 = ns_to_mach(now_ns - pt);
+			break;
+		}
+		case 5: /* fake future deadline at pretend rate */
+		{
+			u64 pt = div_u64(1000000000ULL,
+					   apple_ts_pretend_rate ? apple_ts_pretend_rate : 1);
+			t2 = ns_to_mach(now_ns + pt);
+			break;
+		}
+		default: /* ts2 = previous present (submit-paced) */
+			t2 = prev_ns ? ns_to_mach(prev_ns) : t1;
+			break;
+		}
+		t3 = t1;
+
+		if (apple_ts_log)
+			dev_info(dcp->dev, "swap ts: mode %d period %llu us t1 %llu t2 %llu t3 %llu\n",
+				 apple_ts_mode,
+				 div_u64(period_ns, 1000), t1, t2, t3);
+
+		dcp->ts_prev_flush = ktime_get();
