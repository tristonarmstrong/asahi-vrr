+/*
+ * Apply a live Adaptive Sync state change without a full modeset. Called
+ * from the CRTC flush path when userspace toggles VRR_ENABLED, which it
+ * does via a page-flip commit that must not be turned into a modeset.
+ */
+static void dcp_apply_vrr_flush(struct apple_dcp *dcp,
+				struct drm_crtc_state *crtc_state)
+{
+	struct dcp_display_mode *mode;
+	struct dcp_wait_cookie *cookie;
+	bool want_vrr = force_vrr || crtc_state->vrr_enabled;
+	int ret;
+
+	if (want_vrr == dcp->vrr_enabled)
+		return;
+
+	mode = lookup_mode(dcp, &crtc_state->mode);
+	if (!mode || !mode->vrr)
+		return;
+
+	cookie = kzalloc(sizeof(*cookie), GFP_KERNEL);
+	if (!cookie)
+		return;
+
+	init_completion(&cookie->done);
+	kref_init(&cookie->refcount);
+	kref_get(&cookie->refcount);
+
+	dcp_set_adaptive_sync(dcp, want_vrr ? mode->min_vrr : 0, cookie);
+
+	ret = wait_for_completion_timeout(&cookie->done, msecs_to_jiffies(2000));
+	kref_put(&cookie->refcount, release_wait_cookie);
+	if (ret == 0)
+		dev_warn(dcp->dev, "adaptive_sync flush update timed out\n");
+
+	dcp->vrr_enabled = want_vrr;
+}
